rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) &&
         request.auth.token.email.matches('(?i)^navodtwijesooriya@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved')
      );
    }

    // 1. User Profiles & Approval Management
    match /users/{userId} {
      // Users can read their own profile; system admin can read all users
      allow read: if isOwner(userId) || isAdmin();

      // Account creation during registration:
      // - If admin email, role='admin' and status='approved'
      // - Regular users MUST have role='user' and status='pending'
      allow create: if isOwner(userId) && (
        (
          request.auth.token.keys().hasAll(['email']) &&
          request.auth.token.email.matches('(?i)^navodtwijesooriya@gmail\\.com$') &&
          request.resource.data.role == 'admin' &&
          request.resource.data.status == 'approved'
        ) || (
          request.resource.data.role == 'user' &&
          request.resource.data.status == 'pending'
        )
      );

      // Account updating:
      // - Admin can update any user's role, status, or rejection reason
      // - Regular users can update their own details BUT CANNOT alter role or status
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      // Only the admin can delete user records
      allow delete: if isAdmin();
    }

    // 2. Wedding Projects & Data Isolation
    match /weddings/{weddingId} {
      // Public visitors can read published invitations;
      // Wedding owner or admin can read drafts
      allow read: if resource.data.status == 'published' || 
                     (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));

      // Only approved users or admin can create new wedding projects
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isApprovedUser();

      // Only the wedding owner (who must be approved) or admin can update/delete
      allow update, delete: if isAuthenticated() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          isApprovedUser()
        )
      );

      // 3. Guest RSVPs Subcollection
      match /rsvps/{rsvpId} {
        // Only the wedding owner or admin can read the full guest list
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/weddings/$(weddingId)).data.userId == request.auth.uid
        );

        // Any guest can submit an RSVP with valid payload
        allow create: if request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.attending in ['attending', 'declined'];

        // Only the wedding owner or admin can delete an RSVP
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/weddings/$(weddingId)).data.userId == request.auth.uid
        );
      }
    }
  }
}
